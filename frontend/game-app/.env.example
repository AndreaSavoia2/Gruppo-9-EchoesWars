# Copia questo file e rinominalo ".env", poi metti l'indirizzo del backend.
# Le variabili per Vite DEVONO iniziare con VITE_
VITE_API_URL=http://localhost:3000/api

# Indirizzo della pagina di login STATICA (fatta dall'altra parte del sito).
# Senza token l'app porta qui; dopo il login, la pagina statica torna all'app con #token=...
# Se lo lasci vuoto/commentato, l'app non fa redirect (utile mentre sviluppi).
# VITE_LOGIN_URL=http://localhost:5500/accesso.html

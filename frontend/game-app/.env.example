# Copy this file and rename it ".env", then set the backend address.
# Vite variables MUST start with VITE_
# Spring backend started with Docker (backend folder, port 8080). Note: it ends with /api/v1
VITE_API_URL=http://localhost:8080/api/v1

# Address of the STATIC login page (made by the other part of the website).
# Without a token the app goes there; after the login, the static page comes back to the app with #token=...
# If you leave it empty/commented, the app does not redirect (useful while developing).
# VITE_LOGIN_URL=http://localhost:5500/accesso.html
